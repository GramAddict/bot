# Web Automation Bot - Environment Configuration

# Application Environment
NODE_ENV=production

# Browser & Automation Settings
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_ARGS=--disable-gpu,--disable-dev-shm-usage

# Authentication Credentials (Replace with your actual credentials)
TARGET_USERNAME=your_username_here
TARGET_PASSWORD=your_password_here
TARGET_EMAIL=your_email_here

# Proxy Settings (Optional)
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# Application Port
PORT=3000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Performance & Resource Management
MAX_CONCURRENT_INSTANCES=1
PAGE_LOAD_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=5000

# Update Interval (in milliseconds)
AUTOMATION_INTERVAL=60000
